# 百度地图API配置
# 请在百度地图开放平台申请AK
# https://lbsyun.baidu.com/apiconsole/key
BAIDU_MAP_AK=your_baidu_map_ak_here
BAIDU_MAP_SK=your_baidu_map_sk_here

# 服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_PORT=3000

# 数据库配置
DATABASE_URL=sqlite:///./data/cache.db

# 缓存配置
CACHE_TTL=86400
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=10

# API保护配置
USE_MOCK_DATA=false
DAILY_API_LIMIT=10000
